{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-init.sh\""
          }
        ]
      }
    ],
    "Stop":[
      {
        "hooks":[
	  {
      	    "type":"command",
	    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-log.sh\""
          }
	]
      }
    ],
    "PreToolUse":[
      {
	"matcher":"Bash",
        "hooks":[
	  {
            "type":"command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretool-log.sh\""
	  }
	]
      }
    ],
    "PostToolUse":[
      {
        "matcher":"Write|Edit",
        "hooks":[
	  {
	     "type":"command",
             "command":"bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/posttool-format.sh\""
	  }
	]
      }
    ]
  }
}
